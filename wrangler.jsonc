{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nature-care-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nature-care",
      "database_id": "cc32c88f-22f0-4186-be4b-ab000d413455",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["30 20 * * *", "*/30 * * * *"] },
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nature-care-photos" }],
  "vars": {
    "ENVIRONMENT": "production",
    "STOREFRONT_ORIGINS": "https://natureecarenursery.in, https://www.natureecarenursery.in, https://nature-care.pages.dev",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Shared staff username for the admin sign-in. The password is the secret ADMIN_PASSWORD_HASH (npm run admin-password).
    "ADMIN_USERNAME": "staff",
    "IMAGE_BASE_URL": "https://nature-care-backend.nature-care-backend.workers.dev/img/",
    // Shop WhatsApp number for price enquiries: country code + number, digits only (e.g. 9198XXXXXXXX). Set before go-live.
    "SHOP_WHATSAPP": "918817722220",
    // Pages publishing. PAGES_DEPLOY_HOOK and CF_API_TOKEN are secrets (see README), not vars.
    "CF_ACCOUNT_ID": "c0b808c4b1986f13df5531c4a224d38c",
    "PAGES_PROJECT": "nature-care"
  }
}
