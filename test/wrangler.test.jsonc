// Test-only copy of ../wrangler.jsonc (same bindings and vars). It lives here so Worker tests never load the developer's ../.dev.vars.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nature-care-backend",
  "main": "../src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nature-care",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "nature-care-photos" }],
  "vars": {
    "ENVIRONMENT": "production",
    "STOREFRONT_ORIGINS": "http://localhost:3000",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "IMAGE_BASE_URL": "",
    "SHOP_WHATSAPP": "919999999999",
    "CF_ACCOUNT_ID": "",
    "PAGES_PROJECT": ""
  }
}
